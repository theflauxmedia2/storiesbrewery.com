# Stories Brewery — Apache config for Vite/React SPA (storiesbrewery.com)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Apex is the canonical host. www currently returns 200 on Hostinger; this adds the redirect.
  RewriteCond %{HTTP_HOST} ^www\.storiesbrewery.com$ [NC]
  RewriteRule ^ https://storiesbrewery.com%{REQUEST_URI} [R=301,L]

  # Keep the .html shells off the public URL. THE_REQUEST ignores internal rewrites.
  RewriteCond %{THE_REQUEST} \s/+(about|our-brews|media)\.html[\s?] [NC]
  RewriteRule ^(about|our-brews|media)\.html$ /$1 [R=301,L]

  # Same public URLs as today. Internal rewrite only, including optional trailing slash.
  RewriteRule ^about/?$ /about.html [L]
  RewriteRule ^our-brews/?$ /our-brews.html [L]
  RewriteRule ^media/?$ /media.html [L]

  # Serve existing files & folders as-is (images, css, js, sitemap, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # All other URLs → index.html (React Router handles /about, /our-brews, /media, etc.)
  RewriteRule ^ index.html [L]
</IfModule>

# Fallback if mod_rewrite is unavailable (some shared hosts)
<IfModule !mod_rewrite.c>
  FallbackResource /index.html
</IfModule>

# WebP support
<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Browser caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresDefault "access plus 1 hour"
</IfModule>
