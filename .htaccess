# This file is a reference copy. The deployed version lives in public/.htaccess
# and is copied to dist/ automatically when you run: npm run build
#
# Upload the contents of the dist/ folder to your web host document root.

# Stories Brewery — Apache config for Vite/React SPA (storiesbrewery.com)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Apex is the canonical host. www currently returns 200 on Hostinger; this adds the redirect.
  RewriteCond %{HTTP_HOST} ^www\.storiesbrewery.com$ [NC]
  RewriteRule ^ https://storiesbrewery.com%{REQUEST_URI} [R=301,L]

  # Keep the .html shells off the public URL. THE_REQUEST ignores internal rewrites.
  RewriteCond %{THE_REQUEST} \s/+(about|our-brews|media)\.html[\s?] [NC]
  RewriteRule ^(about|our-brews|media)\.html$ /$1 [R=301,L]

  # Same public URLs as today. Internal rewrite only, including optional trailing slash.
  RewriteRule ^about/?$ /about.html [L]
  RewriteRule ^our-brews/?$ /our-brews.html [L]
  RewriteRule ^media/?$ /media.html [L]

  # Serve existing files & folders as-is (images, css, js, sitemap, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # All other URLs → index.html (React Router handles unknown paths)
  RewriteRule ^ index.html [L]
</IfModule>
